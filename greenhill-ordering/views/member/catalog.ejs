<%- include('../partials/header', { title: 'Order', user }) %>

<h1>Weekly order</h1>

<% if (message) { %>
  <p class="notice"><%= message %></p>
<% } %>

<% if (readOnlyReason) { %>
  <p class="notice"><%= readOnlyReason %></p>
<% } %>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<% if (openRound && canEdit) { %>
  <section>
    <h2>Products (round <%= openRound.id %>, open)</h2>
    <% if (products.length === 0) { %>
      <p>No products available this round.</p>
    <% } else { %>
      <ul class="product-list">
        <% products.forEach(function (product) { %>
          <li>
            <strong><%= product.name %></strong>
            — $<%= product.sell_price.toFixed(2) %>
            <% if (product.sell_method === 'kilogram') { %>(per kg)<% } else { %>(each)<% } %>
            <form method="post" action="/member/order/lines" class="inline-order-form">
              <input type="hidden" name="product_id" value="<%= product.id %>" />
              <label>
                Qty
                <input name="quantity" type="number" min="<%= product.sell_method === 'unit' ? '1' : '0.01' %>" step="<%= product.sell_method === 'unit' ? '1' : '0.01' %>" required />
              </label>
              <button type="submit">Add to order</button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
<% } %>

<section>
  <h2>Your order</h2>
  <% if (lines.length === 0) { %>
    <p>No lines yet.<% if (canEdit) { %> Add products above.<% } %></p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Product</th>
          <th>Qty</th>
          <th>Price</th>
          <th>Line total</th>
          <% if (canEdit) { %><th>Actions</th><% } %>
        </tr>
      </thead>
      <tbody>
        <% lines.forEach(function (line) { %>
          <tr>
            <td><%= line.product_name %></td>
            <td>
              <% if (canEdit) { %>
                <form method="post" action="/member/order/lines/<%= line.id %>/update" class="inline-order-form">
                  <input name="quantity" type="number" min="<%= line.sell_method === 'unit' ? '1' : '0.01' %>" step="<%= line.sell_method === 'unit' ? '1' : '0.01' %>" value="<%= line.quantity %>" required />
                  <button type="submit">Update</button>
                </form>
              <% } else { %>
                <%= line.quantity %><% if (line.sell_method === 'kilogram') { %> kg<% } %>
              <% } %>
            </td>
            <td>$<%= line.unit_price.toFixed(2) %></td>
            <td>$<%= (line.quantity * line.unit_price).toFixed(2) %></td>
            <% if (canEdit) { %>
              <td>
                <form method="post" action="/member/order/lines/<%= line.id %>/remove">
                  <button type="submit">Remove</button>
                </form>
              </td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <% if (canEdit && order) { %>
    <form method="post" action="/member/order/cancel" class="cancel-form" onsubmit="return confirm('Cancel your whole order for this round?');">
      <button type="submit" class="danger">Cancel entire order</button>
    </form>
  <% } %>
</section>

<%- include('../partials/footer') %>
